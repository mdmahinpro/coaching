{
  "name": "@workspace/coaching-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "dev:netlify": "vite --config vite.config.ts --host 127.0.0.1 --port 5173",
    "clean:dist": "node scripts/release-clean.mjs --delete-dist",
    "release:check": "node scripts/release-clean.mjs",
    "build:production": "pnpm run clean:dist && vite build --config vite.config.ts --mode production && pnpm run release:check",
    "build": "pnpm run build:production",
    "serve": "vite preview --config vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "e2e:admin": "node e2e/admin.browser.cjs",
    "e2e:student": "node e2e/student.browser.cjs",
    "e2e:combined": "node e2e/combined-prod-go.browser.cjs",
    "smoke:live": "node e2e/smoke-live.browser.cjs",
    "e2e:isolated:check": "node e2e/run-isolated.cjs --check",
    "e2e:isolated": "node e2e/run-isolated.cjs",
    "provision:customer": "node scripts/provision-customer.mjs",
    "onboard:preflight": "node scripts/onboarding-preflight.mjs",
    "onboard:first-admin": "node scripts/bootstrap-first-admin.mjs",
    "test:onboarding-offline": "vitest run --config scripts/vitest.provisioning.config.mjs scripts/bootstrap-first-admin.test.mjs scripts/onboarding-preflight.test.mjs scripts/release-clean.test.mjs",
    "upgrade:showcase": "node scripts/upgrade-existing.mjs",
    "fixture:showcase": "node scripts/seed-showcase.mjs",
    "check:disposable-connection": "node scripts/check-disposable-connection.mjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/react-query": "^5.90.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "^4.6.0",
    "date-fns": "^3.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.9.0",
    "react-icons": "^5.4.0",
    "rollup-plugin-visualizer": "^5.0.3",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wouter": "^3.3.5"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.13",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.6.3",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-hot-toast": "^2.6.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.14.2",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  }
}
