# Supabase (required)
VITE_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# Exact 20-character ref from the URL above. Production builds fail if omitted or mismatched.
VITE_EXPECTED_SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# One of: development, test, staging, production
VITE_ENVIRONMENT_KIND=development
# Browser-safe public key only: legacy anon JWT or sb_publishable_ key.
# NEVER put a service_role JWT or sb_secret_ key in any VITE_ variable.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-public-key

# Build config (required for Vite)
PORT=3000
BASE_PATH=/

# Optional: site URL for metadata
VITE_SITE_URL=https://yourcoaching.com

# Optional: error tracking (leave empty to disable). @sentry/react is already
# a dependency; just paste the project DSN here to enable production error
# monitoring in Sina's/app Sentry.
VITE_SENTRY_DSN=

# ── Server-side only (serverless function env — NEVER prefixed with VITE_) ──
# These are set in your hosting platform's env settings (Netlify / Vercel),
# not in the client bundle. They power POST /api/send-sms (server/sms-core.ts).
#
# Built-in provider environment fallback only. Database configuration normally
# supplies MIM userName/senderName or Resend from; only API keys are encrypted
# credential material. Missing configured/fallback credentials fail closed.
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_NAME=CoachMS
# Resend transactional email fallback. Each batch entry has exactly one recipient.
RESEND_API_KEY=
RESEND_FROM=CoachMS <notifications@example.com>
# Svix signing secret from the Resend webhook settings (whsec_...).
RESEND_WEBHOOK_SECRET=
# Comma-separated canonical test destinations. Test-send rejects every recipient
# not listed here and requires confirmRealSend=true unless dryRun=true.
MESSAGING_TEST_RECIPIENT_ALLOWLIST=8801700000000,test@example.com
# High-entropy worker secret. Manual workers may send X-Worker-Secret or
# Authorization: Bearer <value>; interactive processing also accepts an admin JWT.
MESSAGING_WORKER_SECRET=
# Vercel injects this as Authorization: Bearer <value> for declared cron routes.
# It is also accepted by worker endpoints using constant-time comparison.
CRON_SECRET=
# Outbound provider requests allow only the exact built-in hosts api.mimsms.com
# and api.resend.com. Add other trusted provider DNS hostnames here as a
# comma-separated server-only list (hostnames only; no wildcards, URLs, IPs,
# credentials, or ports). Subdomains must each be listed explicitly.
PROVIDER_HOST_ALLOWLIST=
# Exact custom provider HTTPS URLs accepted by admin configuration (comma-separated).
# Every hostname must also appear in PROVIDER_HOST_ALLOWLIST. No wildcard matching.
MESSAGING_CUSTOM_ENDPOINT_ALLOWLIST=
# AES-256-GCM keyring for encrypted provider credentials. Each value must be the
# canonical base64 encoding of exactly 32 random bytes. Keep retired keys present
# until all credentials encrypted under them have been replaced with the current key.
MESSAGING_ENCRYPTION_KEYS_JSON={"current":"v1","keys":{"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}}
# Used by the SMS function to verify the caller is an authenticated admin.
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-public-key
# Must exactly identify SUPABASE_URL; required by every serverless endpoint.
EXPECTED_SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# One of: development, test, staging, production
ENVIRONMENT_KIND=development
# Server-only key used by private avatar upload/signed retrieval, the
# admin-authenticated public-assets upload route, and public admission/contact
# RPCs with database-backed abuse limits. Never expose this through a VITE_
# variable or browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Operator-only first-admin bootstrap inputs (do not configure in browser builds).
# Disable public Auth signup during bootstrap. The user must be email-confirmed,
# have the approved identity/provider, and have no pending email change.
BOOTSTRAP_ADMIN_USER_ID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_ALLOWED_PROVIDER=email
